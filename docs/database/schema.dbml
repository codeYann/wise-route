table user {
  id int [pk, not null]
  public_id uuid [unique, not null]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  phone varchar(20)
  password_hash varchar(255) [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

enum vehicle_type {
  CAR
  MOTORCYCLE
  TRUCK
}


table vehicle {
  id int [pk, not null]
  public_id uuid [unique, not null]
  user_id int [not null, ref: > user.id]
  plate varchar(10) [unique, not null]
  type vehicle_type [not null]
  max_capacity int [not null]
  vehicle_year smallint [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

table route {
  id int [pk, not null]
  public_id uuid [unique, not null]
  user_id int [not null, ref: > user.id]
  vehicle_id int [not null, ref: > vehicle.id]
  scenario_id int [ref: > scenario.id]
  name varchar(255)
  depot jsonb [not null]
  points jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp
}

enum optimization_job_status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

table optimization_job {
  id int [pk, not null]
  public_id uuid [unique, not null]
  route_id int [not null, ref: > route.id]
  status optimization_job_status [not null]
  error_message text
  started_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
}

table optimization_result {
  id int [pk, not null]
  job_id int [unique, not null, ref: - optimization_job.id]
  sequence jsonb [not null]
  total_distance int [not null]
  naive_distance int [not null]
  saved_distance int [not null]
  estimated_duration int
  created_at timestamp [not null]
}

table scenario {
  id int [pk, not null]
  public_id uuid [unique, not null]
  user_id int [not null, ref: > user.id]
  name varchar(255) [not null]
  depot jsonb [not null]
  points jsonb [not null]
  created_at timestamp [not null]
  updated_at timestamp
}