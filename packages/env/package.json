{
  "name": "@wise-route/env",
  "version": "1.0.0",
  "description": "Environment variables schemas for Wise Route monorepo",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "biome check",
    "lint:fix": "biome check --fix"
  },
  "keywords": [
    "TypeScript",
    "zod",
    "Environment Variables"
  ],
  "author": "Yan Rodrigues",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.12.x",
    "pnpm": "10.33.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@wise-route/tsconfig": "workspace:*",
    "tsup": "catalog:"
  },
  "dependencies": {
    "dotenv": "17.4.1",
    "zod": "catalog:"
  }
}
