{
  "name": "@wise-route/api",
  "version": "1.0.0",
  "description": "Wise route API package",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --fix"
  },
  "keywords": [
    "API",
    "Node.js",
    "Fastify",
    "TypeScript"
  ],
  "author": "Yan Rodrigues",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.12.x",
    "pnpm": "10.33.0"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "catalog:",
    "@biomejs/biome": "catalog:",
    "@wise-route/config": "workspace:*"
  }
}
